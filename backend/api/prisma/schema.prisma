generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum OnboardingStep {
  INITIAL_DETAILS
  LOCATION_DETAILS
  AVAILABILITY_DETAILS
}

enum HealthcareRole {
  CNA
  LPN
  RN
  PCA
  HHA
  OTHER
}

enum CertificationStatus {
  Certified
  NotCertified
  Pending
  Inprogress
}

enum WorkType {
  FullTime
  PartTime
  PerDiem
  LiveIn
}

enum ShiftType {
  Day
  Night
  Weekend
  Overnight
  Flexible
}

enum JobStatus {
  WorkingFullTime
  WorkingFullTimeAvailable
  WorkingPartTimeAvailable
  NotWorkingAvailable
  NotWorkingOpenOffers
}

enum WorkSettingExperience {
  LTC
  HomeCare
  Hospital
  Rehab
  StartingOut
}

enum PreferredSetting {
  LTC
  HomeCare
  Hospital
  Rehab
  Open
}

enum ThrivingFactor {
  FriendlyTeam
  ClearOnboarding
  FlexibleSchedule
  HigherPay
  ManageableLoad
  CareerGrowth
}

model projects {
  id          String    @id() @default(uuid())
  name        String    @db.VarChar
  description String?   @db.VarChar
  status      String    @default("active") @db.VarChar
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)
  tasks       tasks[]
}

model tasks {
  id           String   @id @default(uuid())
  title        String
  description  String?
  status       String   @default("pending")
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId    String?
  assignedToId String?

  assignedTo   users?     @relation("UserTasks", fields: [assignedToId], references: [id])
  projects     projects?  @relation(fields: [projectId], references: [id])
}

model users {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     tasks[]   @relation("UserTasks")
  candidate candidates?
  saved_jobs  saved_jobs[]

  @@index([email])
  @@unique([email, role])
}

model candidates {
  id                    String   @id @default(uuid())
  name                  String
  email                 String   @unique
  userId                String   @unique
  healthcareRole        HealthcareRole
  certificationStatus   CertificationStatus
  zipCode               String?  // nullable
  address               String?  // nullable
  maxTravelDistance     Int?     // stored in minutes; nullable
  workType              WorkType[]        // multiple select
  shiftType             ShiftType[]       // multiple select
  currentJobStatus      JobStatus?
  step                  OnboardingStep
  isOnboarded           Boolean  @default(false)
  isActive              Boolean  @default(false)
  hourlyRate            Int?
  yearlySalary          Int?
  payLocationBased      Boolean @default(false)
  workSettingExperience WorkSettingExperience[]
  preferredSetting      PreferredSetting[]
  thrivingFactors       ThrivingFactor[]
  jobFrustationNotes    String?
  referredBy            String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // relation
  user                  users    @relation(fields: [userId], references: [id])
  experience            experiences[]

  @@index([email,name])
  @@unique([email,userId])
}

model experiences {
  id                    String   @id @default(uuid())
  candidateId           String   
  employer              String
  role                  String
  startDate             DateTime
  endDate               DateTime?
  isCurrent             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  candidate             candidates @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
}


model jobs {
  id                   String       @id @default(uuid())
  title                String       @db.VarChar
  company              String       @db.VarChar
  location             String?      @db.VarChar
  description          String?      @db.Text
  url                  String       @unique @db.VarChar
  source               String       @db.VarChar
  scrapedDate          DateTime     @db.Date
  postedDate           DateTime?    @db.Date
  jobType              String?      @db.VarChar
  requirements         String[]     @db.VarChar
  benefits             String[]     @db.VarChar
  duties               String[]     @db.VarChar
  shift                String?      @db.VarChar
  experienceRequired   String?      @db.VarChar
  certificationsRequired String[]  @db.VarChar
  salaryMin           Float?       @db.Real
  salaryMax           Float?       @db.Real
  salaryPeriod        String?      @db.VarChar
  city                String?      @db.VarChar
  state               String?      @db.VarChar
  zipCode             String?      @db.VarChar
  status              String       @default("active") @db.VarChar
  createdAt           DateTime     @default(now()) @db.Timestamp(6)
  updatedAt           DateTime     @default(now()) @db.Timestamp(6)
  companyId           String?      @default(uuid())
  company_details     companies?   @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  saved_by            saved_jobs[] 

  @@index([city, state])
}

model companies {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar
  website     String?   @db.VarChar
  description String?   @db.Text
  industry    String?   @db.VarChar
  size        String?   @db.VarChar
  founded     Int?      @db.Integer
  headquarters String?  @db.VarChar
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)
  jobs        jobs[]    

  @@index([name])
}

model scraping_runs {
  id          String    @id @default(uuid())
  source      String    @db.VarChar
  startTime   DateTime  @db.Timestamp(6)
  endTime     DateTime? @db.Timestamp(6)
  status      String    @default("running") @db.VarChar
  totalJobs   Int       @default(0) @db.Integer
  newJobs     Int       @default(0) @db.Integer
  updatedJobs Int       @default(0) @db.Integer
  errors      String[]  @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)
}

model saved_jobs {
  id          String    @id @default(uuid())
  userId      String    @default(uuid())
  jobId       String    @default(uuid())
  notes       String?   @db.Text
  status      String    @default("saved") @db.VarChar
  appliedDate DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)
  user        users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         jobs      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId], name: "saved_jobs_user_job_unique")
  @@index([userId], name: "saved_jobs_user_id_index")
  @@index([jobId], name: "saved_jobs_job_id_index")
  @@index([status], name: "saved_jobs_status_index")
}
