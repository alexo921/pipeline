\cf2 	\'95	short staffing\
	\'95	call light pressure\
	\'95	heavy patient loads\
	\'95	burnout cycles\
	\'95	tense supervisor dynamics\
	\'95	DON and ADON leadership structures\
	\'95	resident family conflicts\
	\'95	floating between units\
