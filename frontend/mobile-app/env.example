# Pipeline Mobile App Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_JAN_API_URL=http://localhost:1337/v1/chat/completions

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# App Configuration
EXPO_PUBLIC_APP_NAME=Pipeline Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0

# Analytics (optional)
EXPO_PUBLIC_ANALYTICS_ID=your-analytics-id

# Feature Flags
EXPO_PUBLIC_ENABLE_CHAT=true
EXPO_PUBLIC_ENABLE_OFFLINE=true
